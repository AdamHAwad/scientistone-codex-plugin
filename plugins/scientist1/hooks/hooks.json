{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/launch-scientist1-mcp\" \"${PLUGIN_ROOT}/hooks/enforce-role-launch.mjs\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\scripts\\launch-scientist1-mcp.cmd\" \"%PLUGIN_ROOT%\\hooks\\enforce-role-launch.mjs\""
          }
        ]
      },
      {
        "matcher": "(?:^|__)scientist1_mcp__(?:wait_for_researcher|attach_run_monitor|prepare_role_launch)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/launch-scientist1-mcp\" \"${PLUGIN_ROOT}/hooks/enforce-study-completion.mjs\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\scripts\\launch-scientist1-mcp.cmd\" \"%PLUGIN_ROOT%\\hooks\\enforce-study-completion.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/launch-scientist1-mcp\" \"${PLUGIN_ROOT}/hooks/enforce-study-completion.mjs\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\scripts\\launch-scientist1-mcp.cmd\" \"%PLUGIN_ROOT%\\hooks\\enforce-study-completion.mjs\"",
            "timeout": 150,
            "statusMessage": "Continuing the approved study through verified delivery"
          }
        ]
      }
    ]
  }
}
